{
  "name": "groupmetoolkit",
  "version": "0.1.0",
  "description": "Read-only GroupMe account tools usable from OpenClaw without a connected MacBook.",
  "repository": "https://github.com/GoatInAHat/groupmetoolkit",
  "keywords": [
    "groupmetoolkit"
  ],
  "type": "module",
  "files": [
    "dist",
    "skills",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node scripts/test-integration.mjs",
    "test:surface": "node scripts/smoke-cli-list.mjs && node scripts/smoke-mcp-surface.mjs && node scripts/smoke-missing-auth.mjs",
    "test:live": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/live.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^15.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "toolfactory": "^0.2.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
