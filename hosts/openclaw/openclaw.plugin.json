{
  "id": "groupmetoolkit",
  "name": "Groupmetoolkit",
  "description": "Read-only GroupMe account tools usable from OpenClaw without a connected MacBook.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "GROUPME_ACCESS_TOKEN": {
        "description": "GroupMe access token; hosts inject the vault-backed value.",
        "type": [
          "string",
          "object"
        ],
        "x-toolfactory": {
          "sensitive": true
        }
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "group",
      "group_messages",
      "groups",
      "me"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "GROUPME_ACCESS_TOKEN",
          "expected": "string"
        }
      ]
    }
  },
  "uiHints": {
    "GROUPME_ACCESS_TOKEN": {
      "sensitive": true
    }
  }
}
