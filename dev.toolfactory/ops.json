{
  "tools": [
    {
      "name": "group",
      "description": "Return one GroupMe group by numeric id. An unknown id surfaces a redacted not_found error; the payload is projected to the declared group shape.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          }
        },
        "required": [
          "id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "private",
              "public"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "share_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "creator_user_id": {
            "type": "string"
          },
          "created_at": {
            "type": "number"
          },
          "updated_at": {
            "type": "number"
          },
          "members": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string"
                    },
                    "nickname": {
                      "type": "string"
                    },
                    "muted": {
                      "type": "boolean"
                    },
                    "image_url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "user_id",
                    "nickname",
                    "muted"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "messages": {
            "type": "object",
            "properties": {
              "count": {
                "type": "number"
              },
              "last_message_id": {
                "type": "string"
              },
              "last_message_created_at": {
                "type": "number"
              },
              "preview": {
                "type": "object",
                "properties": {
                  "nickname": {
                    "type": "string"
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "image_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "attachments": {
                    "type": "array",
                    "items": {}
                  }
                },
                "required": [
                  "nickname",
                  "text",
                  "image_url",
                  "attachments"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "count",
              "last_message_id",
              "last_message_created_at",
              "preview"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "description",
          "image_url",
          "share_url",
          "creator_user_id",
          "created_at",
          "updated_at",
          "members",
          "messages"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "dev.toolfactory": {
          "requires": [
            "net"
          ]
        }
      }
    },
    {
      "name": "group_messages",
      "description": "Read one page of a GroupMe group's message history: projected message ids, timestamps, author names, text and attachments. Supply at most one cursor (before_id = older history, after_id = immediate newer, since_id = newest only); limit is clamped to the official max of 100 (default 20). Pagination metadata is direction-scoped: endOfHistory is only claimed for before_id/latest pages on upstream 304 or a short page, and a non-advancing cursor stops with progressGuardTripped. Nothing is persisted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "before_id": {
            "type": "string",
            "minLength": 1
          },
          "after_id": {
            "type": "string",
            "minLength": 1
          },
          "since_id": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "group_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "created_at": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "attachments": {
                  "type": "array",
                  "items": {}
                }
              },
              "required": [
                "id",
                "created_at",
                "name",
                "attachments"
              ],
              "additionalProperties": false
            }
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "limitClamped": {
            "type": "boolean"
          },
          "pagination": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "before",
                  "after",
                  "since",
                  "latest"
                ]
              },
              "hasContinuation": {
                "type": "boolean"
              },
              "endOfHistory": {
                "type": "boolean"
              },
              "nextBeforeId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nextAfterId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "progressGuardTripped": {
                "type": "boolean"
              },
              "upstreamCount": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "direction",
              "hasContinuation",
              "endOfHistory",
              "nextBeforeId",
              "nextAfterId",
              "progressGuardTripped",
              "upstreamCount"
            ],
            "additionalProperties": false
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "group_id",
          "messages",
          "limit",
          "limitClamped",
          "pagination",
          "warnings"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "dev.toolfactory": {
          "requires": [
            "net"
          ]
        }
      }
    },
    {
      "name": "groups",
      "description": "List the authenticated user's GroupMe groups with pagination. Returns the validated page/per-page echo, a count, and the projected groups. Deliberately no total or hasMore: a bare-array index has no total, and a full page only implies an unknown next page, never a confirmed one.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "per_page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "omit": {
            "type": "string",
            "enum": [
              "memberships"
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "perPage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "private",
                    "public"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "image_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "share_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "creator_user_id": {
                  "type": "string"
                },
                "created_at": {
                  "type": "number"
                },
                "updated_at": {
                  "type": "number"
                },
                "members": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "user_id": {
                            "type": "string"
                          },
                          "nickname": {
                            "type": "string"
                          },
                          "muted": {
                            "type": "boolean"
                          },
                          "image_url": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "user_id",
                          "nickname",
                          "muted"
                        ],
                        "additionalProperties": false
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "messages": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "number"
                    },
                    "last_message_id": {
                      "type": "string"
                    },
                    "last_message_created_at": {
                      "type": "number"
                    },
                    "preview": {
                      "type": "object",
                      "properties": {
                        "nickname": {
                          "type": "string"
                        },
                        "text": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "image_url": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "attachments": {
                          "type": "array",
                          "items": {}
                        }
                      },
                      "required": [
                        "nickname",
                        "text",
                        "image_url",
                        "attachments"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "count",
                    "last_message_id",
                    "last_message_created_at",
                    "preview"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "name",
                "type",
                "description",
                "image_url",
                "share_url",
                "creator_user_id",
                "created_at",
                "updated_at",
                "members",
                "messages"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "page",
          "perPage",
          "count",
          "groups"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "_meta": {
        "dev.toolfactory": {
          "requires": [
            "net"
          ]
        }
      }
